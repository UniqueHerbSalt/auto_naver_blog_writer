# cp .env.example .env 후 채운다. .env 는 커밋하지 않는다.

# 블로그 주소 아이디 (blog.naver.com/<여기>)
NAVER_BLOG_BLOG_ID=myblog

# MCP 접속 토큰. 아무 값이나 길게:  openssl rand -hex 32
NAVER_BLOG_TOKEN=

# noVNC 접속 비밀번호 (최초 네이버 로그인 화면에 들어갈 때 쓴다)
VNC_PASSWORD=

# 기본 공개범위: private(권장) | public
NAVER_BLOG_OPEN_TYPE=private

# 기본 카테고리 이름 (비우면 블로그 기본값)
NAVER_BLOG_CATEGORY=
